# PostgreSQL connection string. Use a dedicated local/dev database.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/brandflight?sslmode=require"

# Generate a random value of at least 32 characters. Never commit the real value.
JWT_SECRET="replace-with-at-least-32-random-characters"

# API runtime / browser origin
PORT=3000
CLIENT_URL="http://localhost:5173"

# Optional semantic audit. Without a key, deterministic checks can run but
# semanticStatus is unavailable and submissions requiring a completed semantic audit are blocked.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"

# Optional image storage; required for image uploads and approved brand assets.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Passwordless role buttons are deliberately disabled by default.
# Set true only on an isolated judge/demo deployment.
DEMO_LOGIN_ENABLED=false

# Used by `npx prisma db seed` to hash the three demo-account passwords.
# Each must be at least 16 characters. Do not use these placeholders as real passwords.
DEMO_CREATOR_PASSWORD="replace-with-a-random-value-at-least-16-chars"
DEMO_MANAGER_PASSWORD="replace-with-a-different-random-value-at-least-16-chars"
DEMO_REVIEWER_PASSWORD="replace-with-another-random-value-at-least-16-chars"
